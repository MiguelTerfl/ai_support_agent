# Copy this file to backend/.env for local development.

# --- Models (Ollama on your PC) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma4:e2b
EMBED_MODEL=embeddinggemma
EMBED_DIM=768
NUM_CTX=8192

# --- Database (docker-compose.dev.yml) ---
DATABASE_URL=postgresql://support:support@localhost:5432/support

# --- RAG ---
MIN_SCORE=0.45
TOP_K=4

# --- Security (locally you can leave the internal key empty) ---
INTERNAL_API_KEY=
CONFIRM_SECRET=dev-secret-cambiar
