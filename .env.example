# Variables for the Coolify deployment (paste them in the "Environment Variables" tab).
# Generate secrets with:  openssl rand -hex 32

POSTGRES_PASSWORD=
INTERNAL_API_KEY=
CONFIRM_SECRET=

# Tailscale IP of your PC (tailscale ip -4) and Ollama port
OLLAMA_BASE_URL=http://100.x.y.z:11434

# Optional (defaults in parentheses)
# LLM_MODEL=gemma4:e2b
# EMBED_MODEL=embeddinggemma        # with another model, adjust EMBED_DIM and the prefixes
# EMBED_DIM=768
# NUM_CTX=8192
# MIN_SCORE=0.45
# RATE_LIMIT_PER_MIN=12
# MAX_CONCURRENT_LLM=2
# TRUSTED_PROXY_HOPS=1              # trusted proxies in front of the frontend (Traefik = 1)
