# Variables for docker-compose.ollama.yml (the models running on your PC).
# Copy to .env.ollama and fill in:  cp .env.ollama.example .env.ollama

# Tailscale auth key: admin console → Settings → Keys → Generate auth key
# (a reusable key avoids having to create a new one if the container is recreated).
TS_AUTHKEY=

# Optional (defaults in parentheses)
# TS_HOSTNAME=ollama-pc            # name the device gets in your tailnet
# LLM_MODEL=gemma4:e2b             # must match the backend's LLM_MODEL
# EMBED_MODEL=embeddinggemma       # must match the backend's EMBED_MODEL
# OLLAMA_KEEP_ALIVE=30m
